{
  "appId": "com.knoxknowsapp.app",
  "appName": "Knox Knows",
  "webDir": "www",
  "server": {
    "hostname": "localhost",
    "iosScheme": "capacitor",
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#FFF8F0",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com",
        "microsoft.com"
      ]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#FFF8F0"
    },
    "Keyboard": {
      "resize": "none",
      "resizeOnFullScreen": false
    },
    "SplashScreen": {
      "launchShowDuration": 10000,
      "launchAutoHide": false,
      "backgroundColor": "#FFF8F0",
      "showSpinner": false,
      "launchFadeOutDuration": 250
    }
  }
}
