rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Billing and usage are written only by the server's Admin SDK.
    function clientUserFields() {
      return ['lastActiveAt', 'firstSeenAt', 'streakCount', 'streakLastDay'];
    }

    // ── Streak + activity checks ───────────────────────────────────────────
    // The app writes { streakCount, streakLastDay: 'YYYY-MM-DD' } after a
    // question, and { lastActiveAt, firstSeenAt } as server timestamps.
    // These checks make sure a streak can only grow by one per day.
    function isDayKey(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function dayTime(s) {
      return timestamp.date(int(s.split('-')[0]), int(s.split('-')[1]), int(s.split('-')[2]));
    }
    // Within two days of now, so any time zone's "today" fits.
    function nearNow(s) {
      return dayTime(s) > request.time - duration.value(2, 'd')
          && dayTime(s) < request.time + duration.value(2, 'd');
    }
    function validActivity(d, old, changed) {
      return (!changed.hasAny(['lastActiveAt']) || d.lastActiveAt == request.time)
          && (!changed.hasAny(['firstSeenAt']) || (!('firstSeenAt' in old) && d.firstSeenAt == request.time));
    }
    function validStreak(d, old, changed) {
      return !changed.hasAny(['streakCount', 'streakLastDay'])
          || (d.streakCount is int && d.streakCount >= 0 && d.streakCount <= 10000
              && isDayKey(d.streakLastDay) && nearNow(d.streakLastDay)
              && (
                // Start (or restart) a streak.
                d.streakCount == 1
                // A new day: grow by exactly one.
                || ('streakLastDay' in old && d.streakLastDay > old.streakLastDay
                    && d.streakCount == old.get('streakCount', 0) + 1)
                // Same count, re-dated forward — or back from a future date
                // (a device whose clock was ahead).
                || ('streakLastDay' in old && d.streakCount == old.get('streakCount', 0)
                    && (d.streakLastDay >= old.streakLastDay
                        || dayTime(old.streakLastDay) > request.time + duration.value(1, 'd')))
              ));
    }

    match /users/{userId} {
      allow read: if owner(userId);
      allow create: if owner(userId)
                    && request.resource.data.keys().hasOnly(clientUserFields())
                    && validActivity(request.resource.data, {}, request.resource.data.keys())
                    && validStreak(request.resource.data, {}, request.resource.data.keys());
      allow update: if owner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientUserFields())
                    && validActivity(request.resource.data, resource.data, request.resource.data.diff(resource.data).affectedKeys())
                    && validStreak(request.resource.data, resource.data, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;

      match /usage/{day} {
        allow read: if owner(userId);
        allow write: if false;
      }

      match /conversations/{conversationId} {
        allow read, delete: if owner(userId);
        allow create, update: if owner(userId)
                              && request.resource.data.keys().hasOnly(['title', 'type', 'learnSessionId', 'createdAt', 'updatedAt', 'deleting'])
                              && request.resource.data.title is string
                              && request.resource.data.title.size() < 200;
        match /messages/{messageId} {
          allow read, delete: if owner(userId);
          allow create: if owner(userId)
                        && getAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)).data.get('deleting', false) == false
                        && request.resource.data.keys().hasOnly(['question', 'answer', 'model', 'ts'])
                        && request.resource.data.question is string
                        && request.resource.data.question.size() <= 8000
                        && request.resource.data.answer is string
                        && request.resource.data.answer.size() <= 100000;
          allow update: if false;
        }
      }

      match /history/{docId} {
        allow read, delete: if owner(userId);
        allow create, update: if owner(userId)
                              && request.resource.data.keys().hasOnly(['question', 'answer', 'plan', 'ts'])
                              && request.resource.data.question is string
                              && request.resource.data.question.size() < 1000
                              && request.resource.data.answer is string
                              && request.resource.data.answer.size() < 5000;
      }

      match /learnSessions/{sessionId} {
        allow read: if owner(userId);
        allow write: if false;
      }

      match /feedback/{docId} {
        allow read: if owner(userId);
        allow create: if owner(userId)
                      && request.resource.data.keys().hasOnly(['rating', 'mode', 'question', 'answer', 'plan', 'ts'])
                      && request.resource.data.rating in [1, -1]
                      && request.resource.data.question is string
                      && request.resource.data.question.size() < 1000
                      && request.resource.data.answer is string
                      && request.resource.data.answer.size() < 5000;
        allow update, delete: if false;
      }
    }

    match /feedback/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'rating', 'mode', 'question', 'answer', 'plan', 'ts'])
                    && request.resource.data.rating in [1, -1]
                    && request.resource.data.question is string
                    && request.resource.data.question.size() < 1000
                    && request.resource.data.answer is string
                    && request.resource.data.answer.size() < 5000;
      allow read, update, delete: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
    match /checkoutLocks/{uid} {
      allow read, write: if false;
    }
    match /billingReview/{eventId} {
      allow read, write: if false;
    }
  }
}
